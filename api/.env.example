# Backend Environment Variables (create .env file in api folder)
PORT=3001
MONGODB_URI=mongodb://localhost:27017/cigar-lounge
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# For production (Railway/Render will provide MONGODB_URI):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cigar-lounge
# JWT_SECRET=use-a-secure-random-string-here
